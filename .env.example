# Kilo AI Gateway Configuration
KILO_API_KEY=your_kilo_api_key_here
KILO_API_URL=https://api.kilo.ai/api/gateway/chat/completions
KILO_MODEL=poolside/laguna-s-2.1:free

# Target Novel Configuration
NOVEL_BASE_URL=https://novelfire.net/book/reverend-insanity
HTTP_REFERER=https://novelfire.net
X_TITLE=Reverend Insanity Literary Arabic Translator

# Scraping & Translation Control
REQUEST_DELAY_SECONDS=20
MAX_RETRIES=5
CHUNK_SIZE_PARAGRAPHS=30
TIMEOUT_SECONDS=90

# Output Directories
OUTPUT_DIR=output
